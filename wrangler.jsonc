{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "geupsik",
	"compatibility_date": "2026-02-24",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"placement": {
		"mode": "smart"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "geupsik",
			"database_id": "08a216d8-c692-4380-b8af-fc298575ca7d"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "59af1acfa9814abe92c36b705d3f72d6"
		}
	]
}
